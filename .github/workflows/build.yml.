name: Build APK
on: workflow_dispatch
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: mkdir proj && unzip -q DominoEngine-Tahap3.zip -d proj
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.9
      - name: Build debug APK
        run: gradle assembleDebug --no-daemon --stacktrace
        working-directory: proj/DominoEngine
      - uses: actions/upload-artifact@v4
        with:
          name: DominoEngine-debug-apk
          path: proj/DominoEngine/app/build/outputs/apk/debug/app-debug.apk
